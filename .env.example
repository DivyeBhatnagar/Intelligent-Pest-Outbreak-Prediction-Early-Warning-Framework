# ============================================================
# Intelligent Pest Outbreak Prediction & Early Warning System
# Environment Variables Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── API Server ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development   # development | production

# ── CORS ─────────────────────────────────────────────────────
# In production, replace * with your actual frontend origin.
ALLOWED_ORIGINS=*

# ── Live Weather ─────────────────────────────────────────────
# Open-Meteo is free and requires NO API key.
# WEATHER_PROVIDER=open-meteo

# ── Optional: SMS Alerts (Twilio) ────────────────────────────
# Leave blank to disable SMS dispatch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Optional: Email Alerts (SMTP) ────────────────────────────
# Leave blank to disable email dispatch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

# ── Database ─────────────────────────────────────────────────
# SQLite path relative to project root (default used if not set).
# DB_PATH=artifacts/pest_framework.db

# ── Model Artifacts ──────────────────────────────────────────
# Override if model files live in a different directory.
# MODELS_DIR=artifacts/models
